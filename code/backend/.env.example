# Copy this to .env and fill in real values. Never commit .env.

# Postgres connection string, e.g.:
# postgresql://user:password@localhost:5432/agriaid
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agriaid

# Secret used to sign JWTs. Use a long random string in real environments.
JWT_SECRET=change-me-to-a-long-random-string

# How long an issued token stays valid.
JWT_EXPIRES_IN=7d

PORT=4000
